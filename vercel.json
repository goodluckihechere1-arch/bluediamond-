{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:static",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/((?!assets/|api/|manus-storage/).*)",
      "destination": "/index.html"
    }
  ]
}
